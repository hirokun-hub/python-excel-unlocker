{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 --turbopack",
    "dev:3001": "next dev -p 3001 --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"frontend/**/*.{ts,tsx,js,jsx}\"",
    "lint:changed": "bash -lc 'BASE=${GITHUB_BASE_REF:-main}; FILES=$(git fetch origin \"$BASE\" >/dev/null 2>&1 || true; git diff --name-only --diff-filter=ACMRT origin/$BASE... | grep \"^frontend/\" | grep -E \"\\.(ts|tsx|js|jsx)$\" || true); if [ -n \"$FILES\" ]; then npx eslint --max-warnings=0 $FILES; else echo \"No changed frontend files\"; fi'",
    "format": "prettier -c \"frontend/**/*.{ts,tsx,js,jsx,css,md}\"",
    "debug:pack": "bash ./scripts/fe-debug.sh",
    "test": "vitest run",
    "test:ui": "playwright test",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/types/api.ts",
    "mock:api": "prism mock ../api/openapi.yaml --port 4010"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^156.0.0",
    "lucide-react": "^0.540.0",
    "next": "15.4.2",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "p-limit": "^3.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.40.1",
    "@stoplight/prism-cli": "^4.1.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "15.4.2",
    "jsdom": "^23.2.0",
    "msw": "^2.0.11",
    "openapi-typescript": "^6.7.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^1.1.3",
    "prettier": "^3.1.1"
  }
}
