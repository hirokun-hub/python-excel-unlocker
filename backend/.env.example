# Excel Unlocker バックエンド環境変数テンプレート
# 使用方法: このファイルを .env.local にコピーして値を設定してください

# AWS設定
AWS_REGION=ap-northeast-1
AWS_PROFILE=default

# S3設定
S3_BUCKET_NAME=excel-unlocker-bucket-development-123456789012-ap-northeast-1

# 認証設定
ALLOWED_USERS=hironomac2025@gmail.com,user2@example.com

# ログ設定
LOG_LEVEL=INFO
AWS_LAMBDA_LOG_LEVEL=INFO

# 環境識別
ENVIRONMENT=development

# Lambda固有設定（本番環境では自動設定）
# PYTHONPATH=/var/runtime
# AWS_LAMBDA_EXEC_WRAPPER=/opt/bootstrap
# PYTHONUNBUFFERED=1