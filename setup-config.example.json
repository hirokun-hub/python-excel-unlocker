{
  "$schema": "./config-schema.json",
  "version": "1.0.0",
  "metadata": {
    "description": "Secure Excel Unlock - 設定ファイルテンプレート",
    "created": "2025-01-19",
    "lastModified": "2025-01-19"
  },
  "environments": {
    "development": {
      "description": "開発環境設定",
      "aws": {
        "region": "ap-northeast-1",
        "profile": "default",
        "s3": {
          "bucketName": "excel-unlock-dev-bucket",
          "corsOrigin": "http://localhost:3000"
        },
        "lambda": {
          "stackName": "excel-unlocker-api-dev",
          "timeout": 300,
          "memorySize": 512
        }
      },
      "google": {
        "clientId": "YOUR_GOOGLE_CLIENT_ID_DEV",
        "clientSecret": "YOUR_GOOGLE_CLIENT_SECRET_DEV",
        "redirectUri": "http://localhost:3000/api/auth/callback/google"
      },
      "vercel": {
        "projectName": "excel-unlock-dev",
        "domain": "excel-unlock-dev.vercel.app",
        "deployToken": "YOUR_EXCEL_UNLOCKER_DEPLOY_TOKEN"
      },
      "security": {
        "allowedUsers": [
          "developer@example.com"
        ],
        "jwtSecret": "YOUR_JWT_SECRET_DEV",
        "sessionSecret": "YOUR_SESSION_SECRET_DEV"
      }
    },
    "staging": {
      "description": "ステージング環境設定",
      "aws": {
        "region": "ap-northeast-1",
        "profile": "staging",
        "s3": {
          "bucketName": "excel-unlock-staging-bucket",
          "corsOrigin": "https://excel-unlock-staging.vercel.app"
        },
        "lambda": {
          "stackName": "excel-unlocker-api-staging",
          "timeout": 300,
          "memorySize": 512
        }
      },
      "google": {
        "clientId": "YOUR_GOOGLE_CLIENT_ID_STAGING",
        "clientSecret": "YOUR_GOOGLE_CLIENT_SECRET_STAGING",
        "redirectUri": "https://excel-unlock-staging.vercel.app/api/auth/callback/google"
      },
      "vercel": {
        "projectName": "excel-unlock-staging",
        "domain": "excel-unlock-staging.vercel.app",
        "deployToken": "YOUR_EXCEL_UNLOCKER_DEPLOY_TOKEN"
      },
      "security": {
        "allowedUsers": [
          "tester@example.com",
          "qa@example.com"
        ],
        "jwtSecret": "YOUR_JWT_SECRET_STAGING",
        "sessionSecret": "YOUR_SESSION_SECRET_STAGING"
      }
    },
    "production": {
      "description": "本番環境設定",
      "aws": {
        "region": "ap-northeast-1",
        "profile": "production",
        "s3": {
          "bucketName": "excel-unlock-prod-bucket",
          "corsOrigin": "https://excel-unlock.example.com"
        },
        "lambda": {
          "stackName": "excel-unlocker-api-prod",
          "timeout": 300,
          "memorySize": 1024
        }
      },
      "google": {
        "clientId": "YOUR_GOOGLE_CLIENT_ID_PROD",
        "clientSecret": "YOUR_GOOGLE_CLIENT_SECRET_PROD",
        "redirectUri": "https://excel-unlock.example.com/api/auth/callback/google"
      },
      "vercel": {
        "projectName": "excel-unlock-prod",
        "domain": "excel-unlock.example.com",
        "deployToken": "YOUR_EXCEL_UNLOCKER_DEPLOY_TOKEN"
      },
      "security": {
        "allowedUsers": [
          "user1@company.com",
          "user2@company.com",
          "admin@company.com"
        ],
        "jwtSecret": "YOUR_JWT_SECRET_PROD",
        "sessionSecret": "YOUR_SESSION_SECRET_PROD"
      }
    }
  },
  "features": {
    "googleDriveIntegration": true,
    "multiFileProcessing": true,
    "realTimeProgress": true,
    "mockMode": false
  },
  "limits": {
    "maxFileSize": 20971520,
    "maxFilesPerBatch": 10,
    "uploadTimeout": 60,
    "downloadTimeout": 300
  },
  "logging": {
    "level": "INFO",
    "enableCloudWatch": true,
    "retentionDays": 30
  }
}