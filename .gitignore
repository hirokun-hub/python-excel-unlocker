# =========================
# 共通 / プロジェクト運用
# =========================

# 監査・作業ログ（ローカル保管用）
_audit/

# OS / ツール固有
.DS_Store

# ローカル秘密ディレクトリ（必要なら名称調整）
/secrets/

# 設定管理システム（機密情報含む）
setup-config.json
setup-config.*.json
!setup-config.example.json
config-backup/
.config-encryption-key


# =========================
# Node.js / Next.js（サブディレクトリ含む）
# =========================
node_modules/
.next/
.next/cache/
coverage/
out/                  # next export の出力
.eslintcache
*.tsbuildinfo
.vercel/

# 各種ログ
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# エディタ設定
.vscode/
.idea/

# 環境変数（どの階層でも無視 / サンプルのみ許可）
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# OAuth/GCP 等の秘密ファイル
client_secret_*.json
*_credentials.json
service-account*.json
*.pem
*.p12

# --- 念押し：フロントエンドの UI コードは必ず追跡（lib/ ルールの副作用対策） ---
!frontend/src/lib/
!frontend/src/lib/**


# =========================
# Python（ルート直下に限定して無視：/ でアンカー）
# =========================

# バイトコード / 最適化 / DLL
__pycache__/
*.py[cod]
*$py.class
*.so

# 配布 / パッケージ（直下のみ）
/.Python
/build/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/*.egg-info
/.installed.cfg
/*.egg
MANIFEST

# PyInstaller（直下のみ）
/*.spec
-pyinstall.log

# テスト / カバレッジ（直下のみ）
/htmlcov/
/.tox/
/.nox/
/.coverage
/.coverage.*
/.cache
/.pytest_cache/
/.hypothesis/

# ドキュメントビルド（直下のみ）
/docs/_build/

# PyBuilder（直下のみ）
/target/

# Jupyter / IPython（直下のみ）
/.ipynb_checkpoints
/profile_default/
/ipython_config.py

# pyenv
/.python-version

# PEP 582
/__pypackages__/

# Celery（直下のみ）
/celerybeat-schedule
/celerybeat.pid


# =========================
# 仮想環境（どこにあっても無視）
# =========================
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/


# =========================
# クラウド/その他
# =========================
.aws-sam/

# 開発時の一時物（パターンがある場合のみ）
frontend/fe-debug-*

# Google Colab専用ファイル（構文エラー回避）
scripts/*Colab*.py
*.py.bak
*.env*
